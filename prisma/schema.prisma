generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum NoteStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum ReportTargetType {
  NOTE
  COMMENT
  USER
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  FAVORITE
  SYSTEM
  REPORT_UPDATE
}

/// 用户账号主体：既承载登录资料，也作为内容、互动、关注、通知和治理的关系中心。
model User {
  id                     String          @id @default(cuid())
  email                  String          @unique
  passwordHash           String          @map("password_hash")
  name                   String
  handle                 String          @unique
  bio                    String?         @db.VarChar(280)
  avatarUrl              String?         @map("avatar_url")
  role                   UserRole        @default(USER)
  status                 UserStatus      @default(ACTIVE)
  notes                  Note[]
  comments               Comment[]
  likes                  Like[]
  favorites              Favorite[]
  following              Follow[]        @relation("UserFollowing")
  followers              Follow[]        @relation("UserFollowers")
  blocking               UserBlock[]     @relation("UserBlocking")
  blockedBy              UserBlock[]     @relation("UserBlockedBy")
  noteDismissals         NoteDismissal[]
  notifications          Notification[]  @relation("NotificationRecipient")
  triggeredNotifications Notification[]  @relation("NotificationActor")
  reportsFiled           Report[]        @relation("ReportReporter")
  reportsReceived        Report[]        @relation("ReportReportedUser")
  auditLogs              AdminAuditLog[] @relation("AdminAuditActor")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@map("users")
}

/// 图文笔记主体：只把结构化字段放在 Note，图片、标签、评论和向量都拆到独立表。
model Note {
  id          String         @id @default(cuid())
  authorId    String         @map("author_id")
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(120)
  slug        String         @unique
  content     String         @db.Text
  status      NoteStatus     @default(DRAFT)
  viewCount   Int            @default(0) @map("view_count")
  images      NoteImage[]
  comments    Comment[]
  likes       Like[]
  favorites   Favorite[]
  dismissals  NoteDismissal[]
  tags        NoteTag[]
  reports     Report[]       @relation("ReportNote")
  embedding   NoteEmbedding?
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([status, publishedAt])
  @@map("notes")
}

/// 笔记图片：一篇笔记可以有多张图，sortOrder 决定详情页和卡片图展示顺序。
model NoteImage {
  id        String   @id @default(cuid())
  noteId    String   @map("note_id")
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([noteId])
  @@map("note_images")
}

/// 评论模型：parentId 为空是一级评论，有 parentId 是二级回复；状态字段用于软删除和审核隐藏。
model Comment {
  id               String        @id @default(cuid())
  noteId           String        @map("note_id")
  note             Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  authorId         String        @map("author_id")
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId         String?       @map("parent_id")
  parent           Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]     @relation("CommentReplies")
  content          String        @db.Text
  status           CommentStatus @default(VISIBLE)
  deletedAt        DateTime?     @map("deleted_at")
  hiddenAt         DateTime?     @map("hidden_at")
  moderationReason String?       @map("moderation_reason") @db.Text
  reports          Report[]      @relation("ReportComment")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([noteId, createdAt])
  @@index([noteId, status, createdAt])
  @@index([authorId])
  @@map("comments")
}

/// 点赞关系：使用 userId + noteId 复合主键，天然保证同一用户对同一笔记只能点赞一次。
model Like {
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, noteId])
  @@index([noteId])
  @@map("likes")
}

/// 收藏关系：和点赞一样是复合主键，但业务含义更偏长期偏好，可用于推荐排序。
model Favorite {
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, noteId])
  @@index([noteId])
  @@map("favorites")
}

/// 关注关系：followerId 关注 followingId，双向计数通过 UserFollowing/UserFollowers 两个 relation 读取。
model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

/// 用户屏蔽关系：blocker 屏蔽 blocked；创建屏蔽时业务层会同步切断双方关注关系。
model UserBlock {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// 不感兴趣负反馈：只影响当前用户的 Feed/Search/详情读取，不改变笔记公开状态。
model NoteDismissal {
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  reason    String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, noteId])
  @@index([noteId])
  @@map("note_dismissals")
}

/// 标签：当前用于内容归类和搜索过滤，后续可扩展为话题页、榜单和运营专题。
model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  notes     NoteTag[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("tags")
}

/// 笔记和标签的多对多关系表。
model NoteTag {
  noteId String @map("note_id")
  tagId  String @map("tag_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

/// 站内通知：互动、关注、系统和举报处理结果都写入这里，readAt 为空表示未读。
model Notification {
  id          String           @id @default(cuid())
  recipientId String           @map("recipient_id")
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?          @map("actor_id")
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  body        String?
  href        String?
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

/// 举报记录：支持举报笔记、评论和用户，后台通过 status/resolution 完成处理闭环。
model Report {
  id             String           @id @default(cuid())
  reporterId     String           @map("reporter_id")
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType @map("target_type")
  noteId         String?          @map("note_id")
  note           Note?            @relation("ReportNote", fields: [noteId], references: [id], onDelete: Cascade)
  commentId      String?          @map("comment_id")
  comment        Comment?         @relation("ReportComment", fields: [commentId], references: [id], onDelete: Cascade)
  reportedUserId String?          @map("reported_user_id")
  reportedUser   User?            @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         String
  detail         String?          @db.Text
  status         ReportStatus     @default(OPEN)
  resolution     String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([targetType])
  @@map("reports")
}

/// 管理员操作审计：重要治理动作都写入这里，便于追踪谁在什么时候处理了什么对象。
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

/// 笔记向量：pgvector 存储语义 embedding，Prisma 暂用 Unsupported 映射。
model NoteEmbedding {
  noteId     String                      @id @map("note_id")
  note       Note                        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  embedding  Unsupported("vector(1536)")
  model      String                      @default("text-embedding-3-small")
  sourceText String                      @map("source_text") @db.Text
  createdAt  DateTime                    @default(now()) @map("created_at")
  updatedAt  DateTime                    @updatedAt @map("updated_at")

  @@map("note_embeddings")
}
