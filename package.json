{
  "name": "rednote",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.21.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "ci": "pnpm migration:check && pnpm env:check && pnpm lint && pnpm test && pnpm typecheck",
    "env:check": "tsx scripts/check-env.ts",
    "env:check:production": "tsx scripts/check-env.ts --mode production",
    "smoke:routes": "tsx scripts/check-core-routes.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma generate && prisma db seed",
    "migration:check": "tsx scripts/check-migrations.ts",
    "db:reset": "prisma migrate reset",
    "db:setup": "tsx scripts/setup-local-db.ts",
    "storage:bucket": "tsx scripts/setup-minio.ts",
    "services:up": "docker compose up -d postgres redis minio",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "openai": "^6.39.1",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
